NEXT_PUBLIC_APP_NAME="Intelligent Land Record Digitization and Validation System"
NEXT_PUBLIC_PORTAL_ORG="Ministry of Rural Development • Department of Land Resources (DoLR)"
NEXT_PUBLIC_DILRMP_COMPLIANT="true"

# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# GIS Map Configuration
NEXT_PUBLIC_MAP_DEFAULT_LAT=9.9625
NEXT_PUBLIC_MAP_DEFAULT_LNG=78.1278
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=16

# AI Service Microservice URL (FastAPI)
AI_SERVICE_URL="http://localhost:8000"

# Direct Database URL (PostgreSQL 16/17 with PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/land_records_db?schema=public"

# Auth Secret
JWT_SECRET="sih2026-dolr-secure-secret-token"
